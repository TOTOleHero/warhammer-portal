<div class="list-group list-group-flush">
  {% for race in races %}
    <a href="{{ path('race_show', {'id': race.id}) }}" 
       class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
      <h6 class="mb-0 text-white">
        <i class="far fa-meh-blank text-danger mr-2"></i> {{ race.name }}
      </h6>
      <small class="text-muted rounded-pill border border-secondary px-2" style="background: rgba(0,0,0,0.3); font-size: 0.75rem;">3 days ago</small>
    </a>
  {% else %}
    <div class="list-group-item bg-transparent text-muted border-secondary text-center">
      <small>No data</small>
    </div>
  {% endfor %}
</div>