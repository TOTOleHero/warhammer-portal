{# race/dropdown.html.twig #}

<div class="dropdown-menu bg-dark border-secondary shadow">
{% for race in races %}
    <a class="dropdown-item text-light" href="{{ path('race_show', {'id': race.id}) }}">
        <i class="far fa-meh-blank text-danger mr-2"></i>{{ race.name }}
    </a>
{% else %}
    <a class="dropdown-item text-muted" href="#">No data</a>
{% endfor %}          
</div>