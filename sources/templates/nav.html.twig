{# nav.html.twig #}
<nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background-color: #0d1117; border-bottom: 1px solid #30363d;">
  <a class="navbar-brand font-weight-bold" href="/">
    <i class="fas fa-shield-alt text-warning mr-2"></i>Fantasy Battle DB
  </a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarColor02" aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarColor02">
    <ul class="navbar-nav mr-auto">
      <li class="nav-item active">
        <a class="nav-link" href="/">Home
          <span class="sr-only">(current)</span>
        </a>
      </li>
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Races</a>
           {{ render(controller(
                    'App\\Controller\\RaceController::index',
                    { 'embedType': 'dropdownList' }
                )) }}
      </li>
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Game Systems</a>
           {{ render(controller(
                    'App\\Controller\\GameSystemController::index',
                    { 'embedType': 'dropdownList' }
                )) }}
      </li>
      
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Nations</a>
           {{ render(controller(
                    'App\\Controller\\NationController::index',
                    { 'embedType': 'dropdownList' }
                )) }}
      </li>
      
    </ul>
    
    <form class="form-inline my-2 my-lg-0 mr-3">
      <input class="form-control mr-sm-2 bg-dark text-light border-secondary" type="text" placeholder="Search">
      <button class="btn btn-outline-secondary my-2 my-sm-0" type="submit">Search</button>
    </form>

    {% if app.user %}
      <div class="nav-item dropdown">
        <a href="#" data-toggle="dropdown" class="nav-item nav-link dropdown-toggle user-action">
          <img src="{{ app.user.email|grAvatar|grSize(36) }}" class="avatar rounded-circle mr-1" alt="Avatar" style="border: 1px solid #30363d;"> 
          {{ app.user.username }} 
          <b class="caret"></b>
        </a>
        <div class="dropdown-menu dropdown-menu-right bg-dark border-secondary shadow">
          <a href="#" class="dropdown-item text-light"><i class="fa fa-user-o mr-2"></i> Profile</a>
          <a href="#" class="dropdown-item text-light"><i class="fa fa-sliders mr-2"></i> Settings</a>
          <div class="divider dropdown-divider border-secondary"></div>
          <a href="{{ path('app_logout') }}" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt mr-2"></i> Logout</a>
        </div>
      </div>
    {% else %}
         <a class="btn btn-warning font-weight-bold text-dark px-3" href="{{ path('app_login') }}">
           <i class="fas fa-sign-in-alt mr-1"></i> Sign in
         </a>
    {% endif %}

  </div>
</nav>