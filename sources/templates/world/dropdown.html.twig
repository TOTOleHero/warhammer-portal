{# world/dropdown.html.twig #}
<div class="dropdown-menu bg-dark border-secondary shadow">
{% for world in worlds %}
    <a class="dropdown-item text-light" href="{{ path('world_show', {'id': world.id}) }}">
        <i class="fas fa-globe text-primary mr-2"></i>{{ world.name }}
    </a>
{% else %}
    <a class="dropdown-item text-muted" href="#">No data</a>
{% endfor %}          
</div>