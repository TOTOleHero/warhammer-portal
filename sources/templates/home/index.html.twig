{% extends 'base-page.html.twig' %}

{% block title %}Fantasy Battle DB{% endblock %}

{% block body2 %}
<div class="container-fluid mt-4 px-lg-5">
    
    <!-- En-tête immersif (remplace le jumbotron) -->
    <div class="p-5 mb-5 rounded shadow-lg header-fantasy text-center text-white">
        <h1 class="display-4 font-weight-bold">
            <i class="fas fa-shield-alt text-warning mr-3"></i>Fantasy Battle DB
        </h1>
        <p class="lead text-light mt-3">This site was created to give to the community a tool to create applications around games related to 25-30mm miniatures and fantasy world.</p>
    </div>

    <div class="row">
        <!-- Colonne Gauche -->
        <div class="col-md-3">
            <div class="card bg-dark text-white border-secondary mb-4 shadow">
                <div class="card-header border-secondary">
                    <h2 class="h5 mb-0"><i class="fas fa-dice-d20 text-info mr-2"></i> Game Systems</h2>
                </div>
                <div class="card-body p-0 custom-list-container">
                    {{ render(controller(
                        'App\\Controller\\GameSystemController::index',
                        { 'embedType': 'groupListContainer' }
                    )) }}
                </div>
            </div>
            
            <div class="card bg-dark text-white border-secondary mb-4 shadow">
                <div class="card-header border-secondary">
                    <h2 class="h5 mb-0"><i class="fas fa-dragon text-danger mr-2"></i> Races</h2>
                </div>
                <div class="card-body p-0 custom-list-container">
                     {{ render(controller(
                        'App\\Controller\\RaceController::index',
                        { 'embedType': 'groupListContainer' }
                    )) }}
                </div>
            </div>
        </div>

        <!-- Colonne Centrale -->
        <div class="col-md-6">
            <div class="card bg-dark text-white border-secondary mb-4 shadow-lg">
                <div class="card-header border-secondary">
                    <h3 class="h5 mb-0"><i class="fas fa-chart-bar text-success mr-2"></i> Stats</h3>
                </div>
                <div class="card-body">
                    <table class="table table-dark table-borderless table-hover mb-0 custom-table">
                        <tbody>
                        {% for object,total in stats %}
                        <tr class="border-bottom border-secondary">
                            <th scope="row" class="text-light">{{ object }}</th>
                            <td class="text-right text-warning font-weight-bold">{{ total }}</td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bg-dark text-white border-secondary shadow info-card">
                <div class="card-body text-center text-muted">
                    <p class="mb-3">You can find the API with Swagger at <a href="/api/doc" class="text-warning text-decoration-none font-weight-bold">{{ url('home') }}api/doc</a>.</p>
                    <p class="mb-3">Some initials data was Loaded from projet Battle Scribe Data <a href="https://github.com/BSData" class="text-info text-decoration-none">https://github.com/BSData</a>.</p>
                    <p class="mb-0">You can see the timeline of multitude of games system at <a href="{{ url('timeline_index') }}" class="btn btn-sm btn-outline-warning ml-2">Timeline</a>.</p>
                </div>
            </div>
        </div>

        <!-- Colonne Droite -->
        <div class="col-md-3">
            <div class="card bg-dark text-white border-secondary mb-4 shadow">
                <div class="card-header border-secondary">
                    <h2 class="h5 mb-0"><i class="fas fa-globe-europe text-primary mr-2"></i> Worlds</h2>
                </div>
                <div class="card-body p-0 custom-list-container">
                    {{ render(controller(
                        'App\\Controller\\WorldController::index',
                        { 'embedType': 'groupListContainer' }
                    )) }}
                </div>
            </div>

            <div class="card bg-dark text-white border-secondary mb-4 shadow">
                <div class="card-header border-secondary">
                    <h2 class="h5 mb-0"><i class="fas fa-flag text-secondary mr-2"></i> Nations</h2>
                </div>
                <div class="card-body p-0 custom-list-container">
                    {{ render(controller(
                        'App\\Controller\\NationController::index',
                        { 'embedType': 'groupListContainer' }
                    )) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}