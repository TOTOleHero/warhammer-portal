{# parameter gamesystem to filter with gameSystem #}
<div class="list-group list-group-flush">
{% for nation in nations %}
  {% set linkParams = {'id': nation.id } %}
  {% set nationRoute = 'nation_show' %}
  
  {% if gameSystemId|default(false) %}
      {% set linkParams = {'id': nation.id, 'gameSystem' : gameSystemId } %}
      {% set nationRoute = 'nation_gameSystem_show' %}
  {% endif %}
  
  <a href="{{ path(nationRoute, linkParams) }}" 
     class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-white">
      <i class="fas fa-flag text-white mr-2"></i> {{ nation.name }}
    </h6>
    <small class="text-muted rounded-pill border border-secondary px-2" style="background: rgba(0,0,0,0.3); font-size: 0.75rem;">3 days ago</small>
  </a>
{% else %}
  <div class="list-group-item bg-transparent text-muted border-secondary text-center">
    <small>No data</small>
  </div>
{% endfor %}
</div>